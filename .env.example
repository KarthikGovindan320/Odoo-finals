# PostgreSQL — a local instance, never a hosted BaaS.
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=peoplepay360
PGUSER=postgres
PGPASSWORD=

# HTTP
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# Session cookie signing is not used — tokens are random and stored hashed.
# This only controls how long a login lasts.
SESSION_TTL_HOURS=12

# Outbound mail. Points at Mailpit from docker-compose; no third-party mail service.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="PeoplePay360 Payroll <payroll@peoplepay360.local>"
