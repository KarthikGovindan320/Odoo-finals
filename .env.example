# PostgreSQL — a local instance, never a hosted BaaS.
PGHOST=/var/run/postgresql
PGPORT=5432
PGDATABASE=peoplepay360
PGUSER=postgres
PGPASSWORD=

# HTTP
PORT=4000
# Set explicitly. Diagnostic detail in error responses requires NODE_ENV=development,
# so an unset value costs diagnostics rather than leaking internals.
NODE_ENV=development
# Required once NODE_ENV=production -- there is no safe default for it there.
WEB_ORIGIN=http://localhost:5173

# How many reverse proxies sit in front of this server. 0 = none, so request.ip
# comes from the socket rather than from a header the client controls.
TRUST_PROXY=0

# Failed logins allowed per email and per IP inside the window before the
# endpoint starts refusing. Applies to authentication only.
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Session cookie signing is not used — tokens are random and stored hashed.
# This only controls how long a login lasts.
SESSION_TTL_HOURS=12

# Outbound mail. Points at Mailpit from docker-compose; no third-party mail service.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="PeoplePay360 Payroll <payroll@peoplepay360.local>"
